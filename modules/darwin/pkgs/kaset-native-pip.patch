+    /// Hands the video to the system picture in picture window.
+    ///
+    /// Sits over the top-right corner of the video and fades in on hover, the
+    /// way the system's own picture in picture window reveals its controls.
+    /// Returning is handled by that window's restore control, so this only
+    /// enters.
+    private var nativePictureInPictureButton: some View {
+        Button {
+            YouTubeWatchWebView.shared.enterNativePictureInPicture()
+            HapticService.toggle()
+        } label: {
+            Image(systemName: "pip.enter")
+                .font(.system(size: 14, weight: .medium))
+                .foregroundStyle(.white)
+                .frame(width: 30, height: 30)
+                .background(.black.opacity(0.55), in: .circle)
+                .overlay {
+                    Circle().strokeBorder(.white.opacity(0.25), lineWidth: 0.5)
+                }
+        }
+        .buttonStyle(.plain)
+        .padding(10)
+        .opacity(self.isHoveringVideoSurface ? 1 : 0)
+        .animation(.easeInOut(duration: 0.15), value: self.isHoveringVideoSurface)
+        .help(String(localized: "Picture in Picture"))
+        .accessibilityLabel(String(localized: "Picture in Picture"))
+        .accessibilityIdentifier(AccessibilityID.YouTubeContent.watchNativePictureInPicture)
+    }
