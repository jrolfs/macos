+++ b/Sources/Kaset/Services/WebKit/WebKitManager.swift	2026-09-22 01:11:43
@@ -264,6 +264,15 @@
         #endif
 
         configuration.preferences.isElementFullscreenEnabled = true
+        // WebKit gates the context menu's "Enter Picture in Picture" on
+        // Settings::allowsPictureInPictureMediaPlayback, which WKWebView
+        // defaults to false on macOS. WKWebViewConfiguration exposes the public
+        // switch only under TARGET_OS_IPHONE, so reach the macOS SPI setter
+        // `_setAllowsPictureInPictureMediaPlayback:` through KVC.
+        configuration.preferences.setValue(
+            true,
+            forKey: "allowsPictureInPictureMediaPlayback"
+        )
         configuration.mediaTypesRequiringUserActionForPlayback = []
 
         // Enable AirPlay for streaming to Apple TV, HomePod, etc.
