+    /// Moves the watch page's video into the system picture in picture window.
+    ///
+    /// Leaving it is handled by the system window's own control, so there is no
+    /// matching exit call here.
+    func enterNativePictureInPicture() {
+        // `evaluateJavaScript` runs with a forced user gesture, which
+        // `webkitSetPresentationMode` requires via
+        // `MediaElementSession::fullscreenPermitted`.
+        self.webView?.evaluateJavaScript(
+            """
+            (function() {
+                const video = document.querySelector('#movie_player video') || document.querySelector('video');
+                if (!video) { return 'no-video'; }
+                if (typeof video.webkitSetPresentationMode !== 'function') { return 'unsupported'; }
+                if (video.webkitPresentationMode === 'picture-in-picture') { return 'already-active'; }
+                video.webkitSetPresentationMode('picture-in-picture');
+                return 'entered';
+            })();
+            """,
+            completionHandler: nil
+        )
+    }
+
     /// Evaluates JavaScript that returns a string (nil on error).
     private func evaluateForString(_ script: String) async -> String? {
         guard let webView else { return nil }
