#!/usr/bin/env bash
set -euo pipefail

json="$(gh stack view --json)" || {
  echo "gh-stack-parent: not in a gh stack (run from a stacked branch)" >&2
  exit 1
}

echo "$json" | jq -er '
  (.branches | map(.name)) as $n
  | (.branches | to_entries[] | select(.value.isCurrent) | .key) as $i
  | if $i == 0 then .trunk else $n[$i-1] end
'
