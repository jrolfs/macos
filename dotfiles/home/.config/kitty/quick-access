#!/bin/sh

# Carries out the ⌥⇥ binding. Karabiner decides between show and hide from
# whether the panel is the frontmost application, which is the same pair of
# conditions the binding used before any of this was a panel; this script only
# has to act, and to create the panel when there is not one yet.
#
# `kitten quick-access-terminal` is a toggle, which is why it is not used for
# both: pressing ⌥⇥ with the panel visible but buried under another window
# would hide it, when the point is to raise it.

kitty=/opt/homebrew/bin/kitty
kitten=/opt/homebrew/bin/kitten

# The panel is addressed by its own pid, not by taking the newest socket in the
# directory. kitty appends its pid to the listen_on path from kitty.conf and
# never reaps the socket afterwards, and "newest" was only ever the panel while
# the panel was the only kitty running. Anything that opens kitty.app directly
# — the Dock, `open -a`, a `kitty @` that starts one — leaves a socket of its
# own, and once that one is newer every ⌥⇥ is sent to it instead. The panel then
# never moves, which looks exactly like the binding being dead.
#
# The pattern matches the panel's own process. Its `kitten __atexit__` and
# `kitten __watch_conf__` children run from the same nested bundle but exec
# `kitten`, so they do not collide with it.
pid=$(/usr/bin/pgrep -f 'kitty-quick-access\.app/Contents/MacOS/kitty-quick-access' 2>/dev/null | /usr/bin/head -1)
socket="$HOME/.local/share/kitty/socket-$pid"

if [ -z "$pid" ] || ! "$kitty" @ --to "unix:$socket" ls >/dev/null 2>&1; then
  # Nothing to talk to: the first ⌥⇥ after a login has to start the panel, and
  # starting it already shows it.
  exec "$kitten" quick-access-terminal
fi

case "$1" in
show | hide)
  exec "$kitty" @ --to "unix:$socket" resize-os-window --action "$1"
  ;;
*)
  echo "usage: quick-access <show|hide>" >&2
  exit 64
  ;;
esac
