# Pipeline for squircle-corners.slang. The two vars below override the
# like-named `static const` declarations in the shader, so the corner can be
# retuned here without touching any Slang.

startgroup
    # The shape only changes when the panel is resized, so there is nothing to
    # redraw on a timer. Without this the group would run every frame at 20fps
    # forever, for a static mask.
    animation_step 0

    var float RADIUS_PX = 48.0
    var float EXPONENT = 5.0

    shaders squircle-corners
endgroup
