# No flake.nix here — nix searches up to the repo root, where `glide` is a
# devShells output. See the comment on it in flake.nix.

# direnv >= 2.37's `use_flake` does this itself; older direnv doesn't, and then
# `nix print-dev-env --profile .direnv/flake-profile` fails because .direnv
# doesn't exist yet. Harmless once it does.
mkdir -p "$(direnv_layout_dir)"

use flake .#glide
