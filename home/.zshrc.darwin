
#
#
# Aliases ----------------------------------------------------------------------

alias mkbk="mackup backup -f && mackup uninstall -f"
alias mkrs="mackup restore -f && mackup uninstall -f"

alias icn="(cd $HOMESHICK_KINGDOM/macos/icons && sudo ./apply.sh)"

alias nix-rebuild="sudo -E darwin-rebuild build --show-trace"
alias nix-search="nix search nixpkgs"

alias spoon="$(brew --prefix)/bin/hs"


#
#
# Functions --------------------------------------------------------------------

# A switch routinely outruns sudo's five minute timestamp_timeout, and
# nix-darwin runs `brew bundle` back through `sudo --user` on the same tty, so
# the ticket lapses mid-rebuild and Touch ID prompts again. Refresh it in the
# background for the life of the rebuild rather than widening the timeout for
# every sudo on the system. The `repeat` bound caps the refresher in case the
# `always` kill is ever missed.
function nix-switch {
  sudo -v || return 1

  local keepalive rc

  { repeat 120 { sleep 60; sudo -n true 2>/dev/null || break } } &!
  keepalive=$!

  {
    sudo -E darwin-rebuild switch --show-trace "$@"
    rc=$?
  } always {
    kill $keepalive 2>/dev/null
  }

  return $rc
}

function reset-host {
  host=$(hostname -s)

  echo "Setting HostName to ${host}"
  sudo scutil --set HostName $host
  echo "Setting LocalHostName to ${host}"
  sudo scutil --set LocalHostName $host
  echo "Setting ComputerName to ${host}"
  sudo scutil --set ComputerName $host

  echo "Flushing DNS cache..."
  sudo killall -HUP mDNSResponder
}

#
# GitHub CLI → Raycast

source "$XDG_CONFIG_HOME/zsh/github-to-raycast.zsh"

#
# Nix

export NIX_PATH="darwin=$HOME/.nix-defexpr/darwin:nixpkgs=$HOME/.nix-defexpr/nixpkgs:darwin-config=$HOME/.nixpkgs/darwin-configuration.nix"

